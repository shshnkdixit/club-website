# ────────────────────────────────────────────────────────────
# AIML Club Website — Environment Variables
# ────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real Neon
# connection string. Never commit .env.local — it's already
# in .gitignore.
#
# 1. Create a free project at https://neon.tech
# 2. Open your project → "Connect" → copy the "Pooled connection"
#    connection string (it looks like the example below).
# 3. Paste it here as DATABASE_URL.
#
# If DATABASE_URL is not set, the app automatically falls back to
# a local file-backed PGlite database at ./data/file.db — handy for
# offline development, but NOT shared across visitors/devices, so
# production deployments should always set DATABASE_URL.

DATABASE_URL="postgresql://<user>:<password>@<your-neon-host>.neon.tech/<database>?sslmode=require"

# Alternate accepted names (only one is required):
# POSTGRES_URL="postgresql://..."
# NEON_DATABASE_URL="postgresql://..."
